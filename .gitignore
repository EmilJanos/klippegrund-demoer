/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# Klints testresultater (lokale)
klint-test-resultat*.md
klint-stresstest*.md
klint-stortest*.md
klint-*-claude-*.md
klint-*-claude-*.json
klint-*-ukendt-*.md
klint-*-ukendt-*.json

# VS Code-arbejdsområde (Emils egen fil, skal ikke i Git)
*.code-workspace

# Køen for flere sessioner (se CLAUDE.md), deles kun lokalt
OPTAGET.md
